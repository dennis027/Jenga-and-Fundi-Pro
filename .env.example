# =============================================================================
# Fundi / Jenga Pro - central configuration
# Copy to `.env` (gitignored) and fill in real values:   cp .env.example .env
# docker compose reads this file for variable substitution AND passes it to the
# backend container (env_file). Never commit the real .env.
# =============================================================================

# ---- Host port publishing ---------------------------------------------------
# Interface the published ports bind to. 127.0.0.1 = this machine only.
# Use 0.0.0.0 only behind a firewall / reverse proxy.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FUNDI_PRO_PORT=4200
JENGA_PRO_PORT=4300

# ---- Frontends ---------------------------------------------------------------
# Public URL of the API *as the browser sees it* (baked into the Angular
# production bundles at build time; rebuild the frontends after changing it).
# Must end with a slash.
PUBLIC_API_URL=http://localhost:8000/

# ---- Django -------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated host names the API answers to (keep localhost for the
# container health check).
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Browser origins allowed to call the API (the two frontends).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
# Serve uploaded files (/MEDIA/...) from Django. Defaults to DEBUG.
SERVE_MEDIA=True
LOG_LEVEL=INFO
FRONTEND_APP_URL=http://localhost:4200

# ---- PostgreSQL (docker service "db") --------------------------------------
# The backend's DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are derived from
# these by docker-compose.yml.
POSTGRES_DB=fundi_jenga
POSTGRES_USER=fundi_jenga
POSTGRES_PASSWORD=change-me

# ---- Redis (docker service "redis") ----------------------------------------
# Use URL-safe characters only (it is embedded in REDIS_URL).
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=256mb

# ---- M-Pesa (Safaricom Daraja) ---------------------------------------------
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be publicly reachable by Safaricom (e.g. an ngrok / production URL).
MPESA_CALLBACK_URL=https://example.com/api/stk-new-callback/

# ---- Email (SMTP) -----------------------------------------------------------
# For local testing without SMTP use django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- Africa's Talking (SMS OTP) --------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
